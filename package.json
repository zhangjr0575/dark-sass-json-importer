{
  "name": "@zhangjr0575/dark-sass-json-importer",
  "version": "1.0.0",
  "description": "Dart Sass importer for JSON files - import JSON as SCSS variables",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "types.d.ts",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "publish": "npm run test:coverage && npm publish",
    "test:coverage": "npm run build && jest --coverage"
  },
  "keywords": [
    "sass",
    "scss",
    "json",
    "importer",
    "dart-sass",
    "variables",
    "scss-json-importer",
    "dark-sass-json-importer"
  ],
  "author": "zhangjr0575",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangjr0575/dark-sass-json-importer.git"
  },
  "homepage": "https://github.com/zhangjr0575/dark-sass-json-importer#readme",
  "bugs": {
    "url": "https://github.com/zhangjr0575/dark-sass-json-importer/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "sass": ">=1.45.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "sass": "^1.77.0"
  }
}
